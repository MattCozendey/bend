# the fuel that a parse needs in each mode, for a text of at most L bytes
def Fuel.need(mode: Source.Mode, +L: Nat) -> Nat:
  match mode:
    case Source.Mode.term{}:
      1n+Nat.double(L)
    case Source.Mode.tup{}:
      1n+1n+Nat.double(L)
    case Source.Mode.args{f}:
      1n+1n+Nat.double(L)

