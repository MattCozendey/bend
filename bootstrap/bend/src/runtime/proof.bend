  +hks = Inv.run.ks(Fun.C.stop{}, env, ks, x0, x1, x2, x3, x4, x5, x6, x7, mem, prog, size, hinv)
  +hz = Inv.c.hz(x0, x1, x2, mem, prog, size, hic)
