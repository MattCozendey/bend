def Def.le(+f: Nat, +G: Nat, +m: Nat, +F: Nat, +L: Nat, rt1: Le(Source.Term, Source.Term.parse(f, Source.Mode.term{}, []), Source.Term.parse(G, Source.Mode.term{}, []), Shared.Nat.dec(L), True{}), rt2: Le(Source.Term, Source.Term.parse(f, Source.Mode.term{}, []), Source.Term.parse(G, Source.Mode.term{}, []), Shared.Nat.dec(L), True{}), rmore: Le(List<&2, Source.Def>, Source.Book.parse_defs(m, f), Source.Book.parse_defs(F, G), Shared.Nat.dec(L), False{})) ->
