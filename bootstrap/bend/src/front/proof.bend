  Le.bind1(List<&2, Nat>, List<&2, Source.Def>, Source.Parse.name, Source.Parse.name, +k => Source.Parse.bind(Nat, List<&2, Source.Def>, Source.Parse.peek, c => Source.Book.parse_def.of(Bool.and(Source.Name.is_eq(k, Source.Name.of("opaque")), Bool.not(Nat.is_eq(c, 58n))), k, f, Source.Book.parse_defs(m, f))),
    +k => Source.Parse.bind(Nat, List<&2, Source.Def>, Source.Parse.peek, c => Source.Book.parse_def.of(Bool.and(Source.Name.is_eq(k, Source.Name.of("opaque")), Bool.not(Nat.is_eq(c, 58n))), k, G, Source.Book.parse_defs(F, G))), L, True{}, Le.name(L),
