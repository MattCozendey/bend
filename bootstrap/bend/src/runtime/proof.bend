  +h0: {Inv.c(hp, lim, base, mem, prog, size) == True{} : Bool}, +h1: {Nat.is_eq(U32.to_nat(mode), 1n) == True{} : Bool}, +h2: {Rd(vv, mem, H, v) == True{} : Bool}, +h3: {Rd(Enc.frs(k, List.length(&2, Fun.C, prog)), mem, H, ks) == True{} : Bool}) -> {Inv.s(Fun.S.ret{vv, k}, hp, lim, base, c, env, ks, v, mode, mem, prog, size) == True{} : Bool}:
  %Equal.sym(Nat, U32.to_nat(hp), H, hH) : {Bool.and(Inv.c(hp, lim, base, mem, prog, size), Bool.and(Nat.is_eq(U32.to_nat(mode), 1n), Bool.and(Rd(vv, mem, _, v), Rd(Enc.frs(k, List.length(&2, Fun.C, prog)), mem, _, ks)))) == True{} : Bool}
  And.mk(Inv.c(hp, lim, base, mem, prog, size), Bool.and(Nat.is_eq(U32.to_nat(mode), 1n), Bool.and(Rd(vv, mem, H, v), Rd(Enc.frs(k, List.length(&2, Fun.C, prog)), mem, H, ks))), h0,
    And.mk(Nat.is_eq(U32.to_nat(mode), 1n), Bool.and(Rd(vv, mem, H, v), Rd(Enc.frs(k, List.length(&2, Fun.C, prog)), mem, H, ks)), h1,
