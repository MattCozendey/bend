# Helpers of the steps
# ====================

def Inv.c.mkH(+hp: U32, +lim: U32, +base: U32, +mem: Wasm.Mem, +prog: List<&2, Fun.C>, +size: U32, +H: Nat,
  +hH: {U32.to_nat(hp) == H : Nat}, +h0: {Nat.is_le(1n, H) == True{} : Bool}, +h1: {Nat.is_le(H, U32.to_nat(lim)) == True{} : Bool}, +h2: {Nat.is_le(U32.to_nat(lim), U32.to_nat(size)) == True{} : Bool}, +h3: {Nat.is_le(5n, U32.to_nat(size)) == True{} : Bool}, +h4: {Tab(prog, 0n, List.length(&2, Fun.C, prog), mem, H, base) == True{} : Bool}) -> {Inv.c(hp, lim, base, mem, prog, size) == True{} : Bool}:
  %Equal.sym(Nat, U32.to_nat(hp), H, hH) : {Bool.and(Nat.is_le(1n, _), Bool.and(Nat.is_le(_, U32.to_nat(lim)), Bool.and(Nat.is_le(U32.to_nat(lim), U32.to_nat(size)), Bool.and(Nat.is_le(5n, U32.to_nat(size)), Tab(prog, 0n, List.length(&2, Fun.C, prog), mem, _, base))))) == True{} : Bool}
  And.mk(Nat.is_le(1n, H), Bool.and(Nat.is_le(H, U32.to_nat(lim)), Bool.and(Nat.is_le(U32.to_nat(lim), U32.to_nat(size)), Bool.and(Nat.is_le(5n, U32.to_nat(size)), Tab(prog, 0n, List.length(&2, Fun.C, prog), mem, H, base)))), h0,
    And.mk(Nat.is_le(H, U32.to_nat(lim)), Bool.and(Nat.is_le(U32.to_nat(lim), U32.to_nat(size)), Bool.and(Nat.is_le(5n, U32.to_nat(size)), Tab(prog, 0n, List.length(&2, Fun.C, prog), mem, H, base))), h1,
    And.mk(Nat.is_le(U32.to_nat(lim), U32.to_nat(size)), Bool.and(Nat.is_le(5n, U32.to_nat(size)), Tab(prog, 0n, List.length(&2, Fun.C, prog), mem, H, base)), h2,
    And.mk(Nat.is_le(5n, U32.to_nat(size)), Tab(prog, 0n, List.length(&2, Fun.C, prog), mem, H, base), h3,
    h4))))

def Inv.run.mkH(+cc: Fun.C, +e: List<&2, Fun.V>, +k: List<&2, Fun.Fr>, +hp: U32, +lim: U32, +base: U32, +c: U32, +env: U32, +ks: U32, +v: U32, +mode: U32, +mem: Wasm.Mem, +prog: List<&2, Fun.C>, +size: U32, +H: Nat, +hH: {U32.to_nat(hp) == H : Nat},
