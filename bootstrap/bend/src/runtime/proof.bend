  %Equal.sym(Nat, U32.to_nat(hp), H, hH) : {Bool.and(Inv.c(hp, lim, base, mem, prog, size), Bool.and(Nat.is_eq(U32.to_nat(mode), 0n), Bool.and(Rd(RT.Enc.code(cc, List.length(&2, Fun.C, prog)), mem, _, c), Bool.and(Rd(RT.Enc.list(e), mem, _, env), Rd(Enc.frs(k, List.length(&2, Fun.C, prog)), mem, _, ks))))) == True{} : Bool}
  And.mk(Inv.c(hp, lim, base, mem, prog, size), Bool.and(Nat.is_eq(U32.to_nat(mode), 0n), Bool.and(Rd(RT.Enc.code(cc, List.length(&2, Fun.C, prog)), mem, H, c), Bool.and(Rd(RT.Enc.list(e), mem, H, env), Rd(Enc.frs(k, List.length(&2, Fun.C, prog)), mem, H, ks)))), h0,
