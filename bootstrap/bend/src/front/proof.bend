                Source.Parse.bind(List<&2, Nat>, Source.Term, Source.Parse.label(), +k => Source.Bool.if(Source.Parse(Source.Term), Source.Names.has(ks, k), Source.Parse.fail(Source.Term), Source.Parse.bind(Bool, Source.Term, Source.Parse.take(Source.Name.of(",")), c => Source.Term.parse_enum(G, Con{k, ks})))), 1n+M, False{}, True{},
                Le.pure(Source.Term, Source.Term.Enu{List.reverse(&2, List<&2, Nat>, ks)}, M),
