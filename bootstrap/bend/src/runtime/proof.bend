    R.if(Imp.Exp.eqz{RT.E.l(12n)}, Imp.Stm.trap{}, Imp.Stm.skip{}, n, size, L(x0, x1, x2, x3, x4, x5, x6, x7, x0, t9, t10, x11, p, q, x14, x15, x16, x17), mem, Bool.to_u32(U32.is_eq(p, 0)), True{}, {Some{Imp.Res.trap{}} : Maybe<&2, Imp.Res>},
      {==}, Cond.eqz(p, True{}, hv),
      {==}))

