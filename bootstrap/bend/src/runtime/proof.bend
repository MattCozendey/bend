  +hn: {Nat.is_le(1n+Atom.need(a), n) == True{} : Bool}) ->
  {Pass.ok(Fun.C.step(Fun.C.case{a, t, y, nn}, env, ks, prog), Imp.Stm.run(RT.I.step(), n, size, L(x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15, x16, x17), mem), prog, size) == True{} : Bool}:
