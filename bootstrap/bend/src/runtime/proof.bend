# The table
# =========

def Imgs.ext(vs: List<&2, Fun.V>, +ws: List<&2, RT.W>, +off: Nat, +mem: Wasm.Mem, +base: U32,
  +h: {Ws.at(RT.Imgs.ws(RT.Imgs.vals(vs, ws, off)), mem, base, RT.Imgs.off(RT.Imgs.vals(vs, ws, off))) == True{} : Bool}) -> {Ws.at(ws, mem, base, off) == True{} : Bool}:
  match vs:
    case Nil{}:
      h
    case Con{+v, +rest}:
      Imgs.ext(rest, ws, off, mem, base, Img.ext(v, RT.Imgs.ws(RT.Imgs.vals(rest, ws, off)), RT.Imgs.off(RT.Imgs.vals(rest, ws, off)), mem, base, h))

def Imgs.fext(vs: List<&2, Fun.V>, +ws: List<&2, RT.W>, +off: Nat, +h: {RT.Ws.fits(RT.Imgs.ws(RT.Imgs.vals(vs, ws, off))) == True{} : Bool}) -> {RT.Ws.fits(ws) == True{} : Bool}:
  match vs:
    case Nil{}:
      h
    case Con{+v, +rest}:
      Imgs.fext(rest, ws, off, Img.fext(v, RT.Imgs.ws(RT.Imgs.vals(rest, ws, off)), RT.Imgs.off(RT.Imgs.vals(rest, ws, off)), h))

def Imgs.offle(vs: List<&2, Fun.V>, +ws: List<&2, RT.W>, +off: Nat) -> {Nat.is_le(off, RT.Imgs.off(RT.Imgs.vals(vs, ws, off))) == True{} : Bool}:
  match vs:
    case Nil{}:
      Shared.Nat.is_le_refl(off)
    case Con{+v, +rest}:
      Le.t(off, RT.Imgs.off(RT.Imgs.vals(rest, ws, off)), RT.Img.off(RT.Img.val(v, RT.Imgs.ws(RT.Imgs.vals(rest, ws, off)), RT.Imgs.off(RT.Imgs.vals(rest, ws, off)))), Imgs.offle(rest, ws, off), Img.offle(v, RT.Imgs.ws(RT.Imgs.vals(rest, ws, off)), RT.Imgs.off(RT.Imgs.vals(rest, ws, off))))

# the values vs, each read from its word at base + 4 i on
def Vs.rd(vs: List<&2, Fun.V>, +i: Nat, +mem: Wasm.Mem, +H: Nat, +base: U32) -> Bool:
  match vs:
    case Nil{}:
      True{}
    case Con{v, rest}:
      Bool.and(Nat.is_le(4n+Nat.add(U32.to_nat(base), Nat.double(Nat.double(i))), H),
        Bool.and(Rd(v, mem, H, Wasm.Mem.load(U32.add(base, U32.from_nat(Nat.double(Nat.double(i)))), mem)), Vs.rd(rest, 1n+i, mem, H, base)))

def Le.d(a: Nat, b: Nat, h: {Nat.is_le(a, b) == True{} : Bool}) -> {Nat.is_le(Nat.double(a), Nat.double(b)) == True{} : Bool}:
  match a b:
    case 0n _:
      Shared.Nat.is_le_zero(Nat.double(b))
    case 1n+p 0n:
      Shared.Bool.absurd({Nat.is_le(Nat.double(1n+p), 0n) == True{} : Bool}, h)
    case 1n+p 1n+q:
      Le.d(p, q, h)

def Le.dd(+a: Nat, +b: Nat, +h: {Nat.is_le(a, b) == True{} : Bool}) -> {Nat.is_le(Nat.double(Nat.double(a)), Nat.double(Nat.double(b))) == True{} : Bool}:
  Le.d(Nat.double(a), Nat.double(b), Le.d(a, b, h))

def Add.swap(+a: Nat, +b: Nat, +c: Nat) -> {Nat.add(Nat.add(a, b), c) == Nat.add(Nat.add(c, a), b) : Nat}:
  Equal.trans(Nat, Nat.add(Nat.add(a, b), c), Nat.add(a, Nat.add(b, c)), Nat.add(Nat.add(c, a), b), MP.Nat.add_assoc(a, b, c),
    Equal.trans(Nat, Nat.add(a, Nat.add(b, c)), Nat.add(a, Nat.add(c, b)), Nat.add(Nat.add(c, a), b),
      Equal.cong(Nat, Nat, x => Nat.add(a, x), Nat.add(b, c), Nat.add(c, b), MP.Nat.add_comm(b, c)),
      Equal.trans(Nat, Nat.add(a, Nat.add(c, b)), Nat.add(Nat.add(a, c), b), Nat.add(Nat.add(c, a), b),
        Equal.sym(Nat, Nat.add(Nat.add(a, c), b), Nat.add(a, Nat.add(c, b)), MP.Nat.add_assoc(a, c, b)),
        Equal.cong(Nat, Nat, x => Nat.add(x, b), Nat.add(a, c), Nat.add(c, a), MP.Nat.add_comm(a, c)))))

def Q.tkf(+base: U32, +o0: Nat, +k: Nat, +size: U32, +hk: {U32.to_nat(U32.from_nat(k)) == k : Nat},
  +hT: {U32.to_nat(U32.add(base, U32.from_nat(o0))) == Nat.add(o0, U32.to_nat(base)) : Nat}, +h: {Nat.is_le(Nat.add(Nat.add(k, o0), U32.to_nat(base)), U32.to_nat(size)) == True{} : Bool}) ->
  WD.Fits(Nat.add(U32.to_nat(U32.add(base, U32.from_nat(o0))), U32.to_nat(U32.from_nat(k)))):
  %Equal.sym(Nat, U32.to_nat(U32.add(base, U32.from_nat(o0))), Nat.add(o0, U32.to_nat(base)), hT) : WD.Fits(Nat.add(_, U32.to_nat(U32.from_nat(k))))
  %Equal.sym(Nat, U32.to_nat(U32.from_nat(k)), k, hk) : WD.Fits(Nat.add(Nat.add(o0, U32.to_nat(base)), _))
  %Equal.sym(Nat, Nat.add(Nat.add(o0, U32.to_nat(base)), k), Nat.add(Nat.add(k, o0), U32.to_nat(base)), Add.swap(o0, U32.to_nat(base), k)) : WD.Fits(_)
  Fits.le(Nat.add(Nat.add(k, o0), U32.to_nat(base)), size, h)

def Q.tk(+base: U32, +o0: Nat, +k: Nat, +size: U32, +hk: {U32.to_nat(U32.from_nat(k)) == k : Nat},
  +hT: {U32.to_nat(U32.add(base, U32.from_nat(o0))) == Nat.add(o0, U32.to_nat(base)) : Nat}, +h: {Nat.is_le(Nat.add(Nat.add(k, o0), U32.to_nat(base)), U32.to_nat(size)) == True{} : Bool}) ->
  {U32.to_nat(U32.add(U32.add(base, U32.from_nat(o0)), U32.from_nat(k))) == Nat.add(Nat.add(o0, U32.to_nat(base)), k) : Nat}:
  %hT : {U32.to_nat(U32.add(U32.add(base, U32.from_nat(o0)), U32.from_nat(k))) == Nat.add(_, k) : Nat}
  %hk : {U32.to_nat(U32.add(U32.add(base, U32.from_nat(o0)), U32.from_nat(k))) == Nat.add(U32.to_nat(U32.add(base, U32.from_nat(o0))), _) : Nat}
  U.add_nat(U32.add(base, U32.from_nat(o0)), U32.from_nat(k), Q.tkf(base, o0, k, size, hk, hT, h))

# the address of the word k of the table at base + o0
def Q.assoc(+base: U32, +o0: Nat, +k: Nat, +size: U32, +h: {Nat.is_le(Nat.add(Nat.add(k, o0), U32.to_nat(base)), U32.to_nat(size)) == True{} : Bool}) ->
  {U32.add(U32.add(base, U32.from_nat(o0)), U32.from_nat(k)) == U32.add(base, U32.from_nat(Nat.add(k, o0))) : U32}:
  +hk = {Fits.le(k, size, Le.t(k, Nat.add(Nat.add(k, o0), U32.to_nat(base)), U32.to_nat(size),
    Le.t(k, Nat.add(k, o0), Nat.add(Nat.add(k, o0), U32.to_nat(base)), Shared.Nat.is_le_add(k, o0), Shared.Nat.is_le_add(Nat.add(k, o0), U32.to_nat(base))), h)) :
    {U32.to_nat(U32.from_nat(k)) == k : Nat}}
  +ho = Le.t(Nat.add(o0, U32.to_nat(base)), Nat.add(Nat.add(k, o0), U32.to_nat(base)), U32.to_nat(size),
    Nat.le_add_r(o0, Nat.add(k, o0), U32.to_nat(base), Shared.Nat.is_le_add_left(o0, k)), h)
  +hT = {Q.nat(base, o0, size, ho) : {U32.to_nat(U32.add(base, U32.from_nat(o0))) == Nat.add(o0, U32.to_nat(base)) : Nat}}
  U.eq_nat(U32.add(U32.add(base, U32.from_nat(o0)), U32.from_nat(k)), U32.add(base, U32.from_nat(Nat.add(k, o0))),
    Equal.trans(Nat, U32.to_nat(U32.add(U32.add(base, U32.from_nat(o0)), U32.from_nat(k))), Nat.add(Nat.add(o0, U32.to_nat(base)), k), U32.to_nat(U32.add(base, U32.from_nat(Nat.add(k, o0)))),
      Q.tk(base, o0, k, size, hk, hT, h),
      Equal.trans(Nat, Nat.add(Nat.add(o0, U32.to_nat(base)), k), Nat.add(Nat.add(k, o0), U32.to_nat(base)), U32.to_nat(U32.add(base, U32.from_nat(Nat.add(k, o0)))),
        Add.swap(o0, U32.to_nat(base), k),
        Equal.sym(Nat, U32.to_nat(U32.add(base, U32.from_nat(Nat.add(k, o0)))), Nat.add(Nat.add(k, o0), U32.to_nat(base)), Q.nat(base, Nat.add(k, o0), size, h)))))

def Vs.bound(+R: Nat, +i: Nat, +Z: Nat, +H: Nat, +TZ: Nat, +hz: {TZ == Z : Nat},
  +h: {Nat.is_le(4n+Nat.add(Nat.double(Nat.double(Nat.add(R, i))), Z), H) == True{} : Bool}) -> {Nat.is_le(4n+Nat.add(TZ, Nat.double(Nat.double(i))), H) == True{} : Bool}:
  %Equal.sym(Nat, TZ, Z, hz) : {Nat.is_le(4n+Nat.add(_, Nat.double(Nat.double(i))), H) == True{} : Bool}
  %MP.Nat.add_comm(Nat.double(Nat.double(i)), Z) : {Nat.is_le(4n+_, H) == True{} : Bool}
  Le.t(4n+Nat.add(Nat.double(Nat.double(i)), Z), 4n+Nat.add(Nat.double(Nat.double(Nat.add(R, i))), Z), H,
    Nat.le_add_r(Nat.double(Nat.double(i)), Nat.double(Nat.double(Nat.add(R, i))), Z, Le.dd(i, Nat.add(R, i), Shared.Nat.is_le_add_left(i, R))), h)

def Vs.tsh(+R: Nat, +i: Nat, +Z: Nat, +H: Nat, +h: {Nat.is_le(Nat.add(Nat.double(Nat.double(1n+Nat.add(R, i))), Z), H) == True{} : Bool}) ->
  {Nat.is_le(Nat.add(Nat.double(Nat.double(Nat.add(R, 1n+i))), Z), H) == True{} : Bool}:
  %Equal.sym(Nat, Nat.add(R, 1n+i), 1n+Nat.add(R, i), MP.Nat.add_succ(R, i)) : {Nat.is_le(Nat.add(Nat.double(Nat.double(_)), Z), H) == True{} : Bool}
  h

# the values of the image, from the word i of the table at base + o0 on
def Imgs.rd(vs: List<&2, Fun.V>, +ws: List<&2, RT.W>, +off: Nat, +i: Nat, +o0: Nat, +mem: Wasm.Mem, +H: Nat, +base: U32, +size: U32,
  +hat: {Ws.at(RT.Imgs.ws(RT.Imgs.vals(vs, ws, off)), mem, base, RT.Imgs.off(RT.Imgs.vals(vs, ws, off))) == True{} : Bool}, +hf: {RT.Ws.fits(RT.Imgs.ws(RT.Imgs.vals(vs, ws, off))) == True{} : Bool},
  +hrs: {Ws.atf(RT.Imgs.rs(RT.Imgs.vals(vs, ws, off)), mem, base, Nat.add(Nat.double(Nat.double(i)), o0)) == True{} : Bool}, +hle: {Nat.is_le(RT.Imgs.off(RT.Imgs.vals(vs, ws, off)), o0) == True{} : Bool},
  +hT: {Nat.is_le(Nat.add(Nat.double(Nat.double(Nat.add(List.length(&2, Fun.V, vs), i))), Nat.add(o0, U32.to_nat(base))), H) == True{} : Bool}, +hs: {Nat.is_le(H, U32.to_nat(size)) == True{} : Bool},
  +hb: {Nat.is_le(1n, U32.to_nat(base)) == True{} : Bool}) -> {Vs.rd(vs, i, mem, H, U32.add(base, U32.from_nat(o0))) == True{} : Bool}:
  match vs:
    case Nil{}:
      {==}
    case Con{+v, +rest}:
      +hZH = Le.t(Nat.add(o0, U32.to_nat(base)), 4n+Nat.add(Nat.double(Nat.double(Nat.add(List.length(&2, Fun.V, rest), i))), Nat.add(o0, U32.to_nat(base))), H, Shared.Nat.is_le_add_left(Nat.add(o0, U32.to_nat(base)), 4n+Nat.double(Nat.double(Nat.add(List.length(&2, Fun.V, rest), i)))), hT)
      +hTz = {Q.nat(base, o0, size, Le.t(Nat.add(o0, U32.to_nat(base)), H, U32.to_nat(size), hZH, hs)) : {U32.to_nat(U32.add(base, U32.from_nat(o0))) == Nat.add(o0, U32.to_nat(base)) : Nat}}
      +hmono = Nat.le_add_r(Nat.double(Nat.double(i)), Nat.double(Nat.double(Nat.add(List.length(&2, Fun.V, rest), i))), Nat.add(o0, U32.to_nat(base)), Le.dd(i, Nat.add(List.length(&2, Fun.V, rest), i), Shared.Nat.is_le_add_left(i, List.length(&2, Fun.V, rest))))
      +hQ = Le.rwl(Nat.add(Nat.double(Nat.double(i)), Nat.add(o0, U32.to_nat(base))), Nat.add(Nat.add(Nat.double(Nat.double(i)), o0), U32.to_nat(base)), U32.to_nat(size),
        Equal.sym(Nat, Nat.add(Nat.add(Nat.double(Nat.double(i)), o0), U32.to_nat(base)), Nat.add(Nat.double(Nat.double(i)), Nat.add(o0, U32.to_nat(base))), MP.Nat.add_assoc(Nat.double(Nat.double(i)), o0, U32.to_nat(base))),
        Le.t(Nat.add(Nat.double(Nat.double(i)), Nat.add(o0, U32.to_nat(base))), H, U32.to_nat(size),
          Le.t(Nat.add(Nat.double(Nat.double(i)), Nat.add(o0, U32.to_nat(base))), 4n+Nat.add(Nat.double(Nat.double(Nat.add(List.length(&2, Fun.V, rest), i))), Nat.add(o0, U32.to_nat(base))), H,
            Le.t(Nat.add(Nat.double(Nat.double(i)), Nat.add(o0, U32.to_nat(base))), Nat.add(Nat.double(Nat.double(Nat.add(List.length(&2, Fun.V, rest), i))), Nat.add(o0, U32.to_nat(base))), 4n+Nat.add(Nat.double(Nat.double(Nat.add(List.length(&2, Fun.V, rest), i))), Nat.add(o0, U32.to_nat(base))), hmono, Shared.Nat.is_le_add_left(Nat.add(Nat.double(Nat.double(Nat.add(List.length(&2, Fun.V, rest), i))), Nat.add(o0, U32.to_nat(base))), 4n)), hT), hs))
      And.mk(Nat.is_le(4n+Nat.add(U32.to_nat(U32.add(base, U32.from_nat(o0))), Nat.double(Nat.double(i))), H),
        Bool.and(Rd(v, mem, H, Wasm.Mem.load(U32.add(U32.add(base, U32.from_nat(o0)), U32.from_nat(Nat.double(Nat.double(i)))), mem)), Vs.rd(rest, 1n+i, mem, H, U32.add(base, U32.from_nat(o0)))),
        Vs.bound(List.length(&2, Fun.V, rest), i, Nat.add(o0, U32.to_nat(base)), H, U32.to_nat(U32.add(base, U32.from_nat(o0))), hTz, hT),
        And.mk(Rd(v, mem, H, Wasm.Mem.load(U32.add(U32.add(base, U32.from_nat(o0)), U32.from_nat(Nat.double(Nat.double(i)))), mem)), Vs.rd(rest, 1n+i, mem, H, U32.add(base, U32.from_nat(o0))),
          Rd.at(v, mem, H, Wasm.Mem.load(U32.add(U32.add(base, U32.from_nat(o0)), U32.from_nat(Nat.double(Nat.double(i)))), mem), W.u(RT.Img.r(RT.Img.val(v, RT.Imgs.ws(RT.Imgs.vals(rest, ws, off)), RT.Imgs.off(RT.Imgs.vals(rest, ws, off)))), base),
            Equal.trans(U32, Wasm.Mem.load(U32.add(U32.add(base, U32.from_nat(o0)), U32.from_nat(Nat.double(Nat.double(i)))), mem),
              Wasm.Mem.load(U32.add(base, U32.from_nat(Nat.add(Nat.double(Nat.double(i)), o0))), mem), W.u(RT.Img.r(RT.Img.val(v, RT.Imgs.ws(RT.Imgs.vals(rest, ws, off)), RT.Imgs.off(RT.Imgs.vals(rest, ws, off)))), base),
              Equal.cong(U32, U32, x => Wasm.Mem.load(x, mem), U32.add(U32.add(base, U32.from_nat(o0)), U32.from_nat(Nat.double(Nat.double(i)))),
                U32.add(base, U32.from_nat(Nat.add(Nat.double(Nat.double(i)), o0))), Q.assoc(base, o0, Nat.double(Nat.double(i)), size, hQ)),
              W.eq(RT.Img.r(RT.Img.val(v, RT.Imgs.ws(RT.Imgs.vals(rest, ws, off)), RT.Imgs.off(RT.Imgs.vals(rest, ws, off)))), mem, base, Nat.add(Nat.double(Nat.double(i)), o0),
                And.l(W.at(RT.Img.r(RT.Img.val(v, RT.Imgs.ws(RT.Imgs.vals(rest, ws, off)), RT.Imgs.off(RT.Imgs.vals(rest, ws, off)))), mem, base, Nat.add(Nat.double(Nat.double(i)), o0)), Ws.atf(RT.Imgs.rs(RT.Imgs.vals(rest, ws, off)), mem, base, 4n+Nat.add(Nat.double(Nat.double(i)), o0)), hrs))),
            Img.rd(v, RT.Imgs.ws(RT.Imgs.vals(rest, ws, off)), RT.Imgs.off(RT.Imgs.vals(rest, ws, off)), mem, H, base, size, hat, hf,
              Le.t(Nat.add(RT.Img.off(RT.Img.val(v, RT.Imgs.ws(RT.Imgs.vals(rest, ws, off)), RT.Imgs.off(RT.Imgs.vals(rest, ws, off)))), U32.to_nat(base)), Nat.add(o0, U32.to_nat(base)), H, Nat.le_add_r(RT.Img.off(RT.Img.val(v, RT.Imgs.ws(RT.Imgs.vals(rest, ws, off)), RT.Imgs.off(RT.Imgs.vals(rest, ws, off)))), o0, U32.to_nat(base), hle), hZH), hs, hb)),
          Imgs.rd(rest, ws, off, 1n+i, o0, mem, H, base, size,
            Img.ext(v, RT.Imgs.ws(RT.Imgs.vals(rest, ws, off)), RT.Imgs.off(RT.Imgs.vals(rest, ws, off)), mem, base, hat),
            Img.fext(v, RT.Imgs.ws(RT.Imgs.vals(rest, ws, off)), RT.Imgs.off(RT.Imgs.vals(rest, ws, off)), hf),
            And.r(W.at(RT.Img.r(RT.Img.val(v, RT.Imgs.ws(RT.Imgs.vals(rest, ws, off)), RT.Imgs.off(RT.Imgs.vals(rest, ws, off)))), mem, base, Nat.add(Nat.double(Nat.double(i)), o0)), Ws.atf(RT.Imgs.rs(RT.Imgs.vals(rest, ws, off)), mem, base, 4n+Nat.add(Nat.double(Nat.double(i)), o0)), hrs),
            Le.t(RT.Imgs.off(RT.Imgs.vals(rest, ws, off)), RT.Img.off(RT.Img.val(v, RT.Imgs.ws(RT.Imgs.vals(rest, ws, off)), RT.Imgs.off(RT.Imgs.vals(rest, ws, off)))), o0, Img.offle(v, RT.Imgs.ws(RT.Imgs.vals(rest, ws, off)), RT.Imgs.off(RT.Imgs.vals(rest, ws, off))), hle),
            Vs.tsh(List.length(&2, Fun.V, rest), i, Nat.add(o0, U32.to_nat(base)), H, Le.t(Nat.add(Nat.double(Nat.double(1n+Nat.add(List.length(&2, Fun.V, rest), i))), Nat.add(o0, U32.to_nat(base))), 4n+Nat.add(Nat.double(Nat.double(Nat.add(List.length(&2, Fun.V, rest), i))), Nat.add(o0, U32.to_nat(base))), H, Shared.Nat.is_le_refl(4n+Nat.add(Nat.double(Nat.double(Nat.add(List.length(&2, Fun.V, rest), i))), Nat.add(o0, U32.to_nat(base)))), hT)),
            hs, hb)))

# the table of the code of the functions
def Vs.tab(cs: List<&2, Fun.C>, +i: Nat, +len: Nat, +more: List<&2, Fun.V>, +mem: Wasm.Mem, +H: Nat, +base: U32,
  +h: {Vs.rd(List.append(&2, Fun.V, RT.Enc.codes(cs, len), more), i, mem, H, base) == True{} : Bool}) -> {Tab(cs, i, len, mem, H, base) == True{} : Bool}:
  match cs:
    case Nil{}:
      {==}
    case Con{+c, +rest}:
      +bd = Nat.is_le(4n+Nat.add(U32.to_nat(base), Nat.double(Nat.double(i))), H)
      +rd = Rd(RT.Enc.code(c, len), mem, H, Wasm.Mem.load(U32.add(base, U32.from_nat(Nat.double(Nat.double(i)))), mem))
      +vr = Vs.rd(List.append(&2, Fun.V, RT.Enc.codes(rest, len), more), 1n+i, mem, H, base)
      And.mk(bd, Bool.and(rd, Tab(rest, 1n+i, len, mem, H, base)), And.l(bd, Bool.and(rd, vr), h),
        And.mk(rd, Tab(rest, 1n+i, len, mem, H, base), And.l(rd, vr, And.r(bd, Bool.and(rd, vr), h)),
          Vs.tab(rest, 1n+i, len, more, mem, H, base, And.r(rd, vr, And.r(bd, Bool.and(rd, vr), h)))))

# the values after the table of the functions
def Vs.drop(cs: List<&2, Fun.C>, +i: Nat, +len: Nat, +more: List<&2, Fun.V>, +mem: Wasm.Mem, +H: Nat, +base: U32,
  +h: {Vs.rd(List.append(&2, Fun.V, RT.Enc.codes(cs, len), more), i, mem, H, base) == True{} : Bool}) ->
  {Vs.rd(more, Nat.add(List.length(&2, Fun.C, cs), i), mem, H, base) == True{} : Bool}:
  match cs:
    case Nil{}:
      h
    case Con{+c, +rest}:
      +bd = Nat.is_le(4n+Nat.add(U32.to_nat(base), Nat.double(Nat.double(i))), H)
      +rd = Rd(RT.Enc.code(c, len), mem, H, Wasm.Mem.load(U32.add(base, U32.from_nat(Nat.double(Nat.double(i)))), mem))
      +vr = Vs.rd(List.append(&2, Fun.V, RT.Enc.codes(rest, len), more), 1n+i, mem, H, base)
      %MP.Nat.add_succ(List.length(&2, Fun.C, rest), i) : {Vs.rd(more, _, mem, H, base) == True{} : Bool}
      Vs.drop(rest, 1n+i, len, more, mem, H, base, And.r(rd, vr, And.r(bd, Bool.and(rd, vr), h)))

# The loads of the image
# ======================

# a load above a store
def Ld.above(+p: U32, +q: U32, +mem: Wasm.Mem, +x: U32, +size: U32,
  +hqp: {Nat.is_le(4n+U32.to_nat(q), U32.to_nat(p)) == True{} : Bool}, +hp: {Nat.is_le(4n+U32.to_nat(p), U32.to_nat(size)) == True{} : Bool}) ->
  {Wasm.Mem.load(p, Wasm.Mem.store(q, mem, x)) == Wasm.Mem.load(p, mem) : U32}:
  +hps = Le.t(U32.to_nat(p), 4n+U32.to_nat(p), U32.to_nat(size), Shared.Nat.is_le_add_left(U32.to_nat(p), 4n), hp)
  %WP.U.from_to_nat(p) : {Wasm.Mem.load(_, Wasm.Mem.store(q, mem, x)) == Wasm.Mem.load(_, mem) : U32}
  %WP.U.from_to_nat(q) :
    {Wasm.Mem.load(U32.from_nat(U32.to_nat(p)), Wasm.Mem.store(_, mem, x)) == Wasm.Mem.load(U32.from_nat(U32.to_nat(p)), mem) : U32}
  WP.M.load_store_hi(U32.to_nat(p), U32.to_nat(q), mem, x,
    Fits.le(3n+U32.to_nat(p), size, Shared.Nat.is_le_pred(3n+U32.to_nat(p), U32.to_nat(size), hp)),
    Fits.le(3n+U32.to_nat(q), size, Le.t(3n+U32.to_nat(q), U32.to_nat(p), U32.to_nat(size), Shared.Nat.is_le_pred(3n+U32.to_nat(q), U32.to_nat(p), hqp), hps)), hqp)

# the memory after the loads of the words ws (the last first) below base + e
def Ldr.mem(ws: List<&2, RT.W>, +base: U32, e: Nat, mem: Wasm.Mem) -> Wasm.Mem:
  match ws e:
    case Con{w, rest} 4n++x:
      Wasm.Mem.store(U32.add(base, U32.from_nat(x)), Ldr.mem(rest, base, x, mem), W.u(w, base))
    case _ _:
      mem

# the memory after the loads of the words ws from base + o on
def Ld.mem(ws: List<&2, RT.W>, +base: U32, +o: Nat, mem: Wasm.Mem) -> Wasm.Mem:
  match ws:
    case Nil{}:
      mem
    case Con{w, rest}:
      Ld.mem(rest, base, 4n+o, Wasm.Mem.store(U32.add(base, U32.from_nat(o)), mem, W.u(w, base)))

# whether the words ws (the last first) fit below e
def Ws.fit(ws: List<&2, RT.W>, e: Nat) -> Bool:
  match ws e:
    case Nil{} _:
      True{}
    case Con{w, rest} 4n++x:
      Ws.fit(rest, x)
    case _ _:
      False{}

# a word below a store keeps
def W.keep(+w: RT.W, +mem: Wasm.Mem, +base: U32, +x: Nat, +q: U32, +u: U32, +size: U32,
  +hq: {Nat.is_le(4n+Nat.add(x, U32.to_nat(base)), U32.to_nat(q)) == True{} : Bool}, +hqs: {Nat.is_le(4n+U32.to_nat(q), U32.to_nat(size)) == True{} : Bool},
  +h: {W.at(w, mem, base, x) == True{} : Bool}) -> {W.at(w, Wasm.Mem.store(q, mem, u), base, x) == True{} : Bool}:
  +hxs = Le.t(Nat.add(x, U32.to_nat(base)), U32.to_nat(q), U32.to_nat(size),
    Le.t(Nat.add(x, U32.to_nat(base)), 4n+Nat.add(x, U32.to_nat(base)), U32.to_nat(q), Shared.Nat.is_le_add_left(Nat.add(x, U32.to_nat(base)), 4n), hq),
    Le.t(U32.to_nat(q), 4n+U32.to_nat(q), U32.to_nat(size), Shared.Nat.is_le_add_left(U32.to_nat(q), 4n), hqs))
  +hx = {Q.nat(base, x, size, hxs) : {U32.to_nat(U32.add(base, U32.from_nat(x))) == Nat.add(x, U32.to_nat(base)) : Nat}}
  %Equal.sym(U32, Wasm.Mem.load(U32.add(base, U32.from_nat(x)), Wasm.Mem.store(q, mem, u)), Wasm.Mem.load(U32.add(base, U32.from_nat(x)), mem),
    Ld.far(U32.add(base, U32.from_nat(x)), q, mem, u, size, Le.rwl(4n+Nat.add(x, U32.to_nat(base)), 4n+U32.to_nat(U32.add(base, U32.from_nat(x))), U32.to_nat(q),
      Equal.cong(Nat, Nat, y => 4n+y, Nat.add(x, U32.to_nat(base)), U32.to_nat(U32.add(base, U32.from_nat(x))), Equal.sym(Nat, U32.to_nat(U32.add(base, U32.from_nat(x))), Nat.add(x, U32.to_nat(base)), hx)), hq), hqs)) :
    {Nat.is_eq(U32.to_nat(_), U32.to_nat(W.u(w, base))) == True{} : Bool}
  h

def Ws.keep1(ws: List<&2, RT.W>, e: Nat, +mem: Wasm.Mem, +base: U32, +q: U32, +u: U32, +size: U32,
  +hq: {Nat.is_le(Nat.add(e, U32.to_nat(base)), U32.to_nat(q)) == True{} : Bool}, +hqs: {Nat.is_le(4n+U32.to_nat(q), U32.to_nat(size)) == True{} : Bool},
  +h: {Ws.at(ws, mem, base, e) == True{} : Bool}) -> {Ws.at(ws, Wasm.Mem.store(q, mem, u), base, e) == True{} : Bool}:
  match ws e:
    case Nil{} _:
      {==}
    case Con{+w, +rest} 0n:
      h
    case Con{+w, +rest} 1n:
      h
    case Con{+w, +rest} 2n:
      h
    case Con{+w, +rest} 3n:
      h
    case Con{+w, +rest} 4n++x:
      And.mk(W.at(w, Wasm.Mem.store(q, mem, u), base, x), Ws.at(rest, Wasm.Mem.store(q, mem, u), base, x),
        W.keep(w, mem, base, x, q, u, size, hq, hqs, And.l(W.at(w, mem, base, x), Ws.at(rest, mem, base, x), h)),
        Ws.keep1(rest, x, mem, base, q, u, size,
          Le.t(Nat.add(x, U32.to_nat(base)), 4n+Nat.add(x, U32.to_nat(base)), U32.to_nat(q), Shared.Nat.is_le_add_left(Nat.add(x, U32.to_nat(base)), 4n), hq), hqs,
          And.r(W.at(w, mem, base, x), Ws.at(rest, mem, base, x), h)))

def Ldr.at1(+w: RT.W, +M: Wasm.Mem, +base: U32, +x: Nat, +size: U32, +h4: {Nat.is_le(4n+U32.to_nat(U32.add(base, U32.from_nat(x))), U32.to_nat(size)) == True{} : Bool}) ->
  {W.at(w, Wasm.Mem.store(U32.add(base, U32.from_nat(x)), M, W.u(w, base)), base, x) == True{} : Bool}:
  %Equal.sym(U32, Wasm.Mem.load(U32.add(base, U32.from_nat(x)), Wasm.Mem.store(U32.add(base, U32.from_nat(x)), M, W.u(w, base))), W.u(w, base), Ld.same(U32.add(base, U32.from_nat(x)), M, W.u(w, base), size, h4)) :
    {Nat.is_eq(U32.to_nat(_), U32.to_nat(W.u(w, base))) == True{} : Bool}
  WP.Nat.is_eq_refl(U32.to_nat(W.u(w, base)))

# after the loads below base + e, the memory holds the words
def Ldr.at(ws: List<&2, RT.W>, e: Nat, +mem: Wasm.Mem, +base: U32, +size: U32, +hfit: {Ws.fit(ws, e) == True{} : Bool},
  +hs: {Nat.is_le(Nat.add(e, U32.to_nat(base)), U32.to_nat(size)) == True{} : Bool}) -> {Ws.at(ws, Ldr.mem(ws, base, e, mem), base, e) == True{} : Bool}:
  match ws e:
    case Nil{} _:
      {==}
    case Con{+w, +rest} 0n:
      hfit
    case Con{+w, +rest} 1n:
      hfit
    case Con{+w, +rest} 2n:
      hfit
    case Con{+w, +rest} 3n:
      hfit
    case Con{+w, +rest} 4n++x:
      +M = Ldr.mem(rest, base, x, mem)
      +hxs = Le.t(Nat.add(x, U32.to_nat(base)), 4n+Nat.add(x, U32.to_nat(base)), U32.to_nat(size), Shared.Nat.is_le_add_left(Nat.add(x, U32.to_nat(base)), 4n), hs)
      +hx = {Q.nat(base, x, size, hxs) : {U32.to_nat(U32.add(base, U32.from_nat(x))) == Nat.add(x, U32.to_nat(base)) : Nat}}
      +h4 = Le.rwl(4n+Nat.add(x, U32.to_nat(base)), 4n+U32.to_nat(U32.add(base, U32.from_nat(x))), U32.to_nat(size),
        Equal.cong(Nat, Nat, y => 4n+y, Nat.add(x, U32.to_nat(base)), U32.to_nat(U32.add(base, U32.from_nat(x))), Equal.sym(Nat, U32.to_nat(U32.add(base, U32.from_nat(x))), Nat.add(x, U32.to_nat(base)), hx)), hs)
      And.mk(W.at(w, Wasm.Mem.store(U32.add(base, U32.from_nat(x)), M, W.u(w, base)), base, x), Ws.at(rest, Wasm.Mem.store(U32.add(base, U32.from_nat(x)), M, W.u(w, base)), base, x),
        Ldr.at1(w, M, base, x, size, h4),
        Ws.keep1(rest, x, M, base, U32.add(base, U32.from_nat(x)), W.u(w, base), size,
          Le.rwl(Nat.add(x, U32.to_nat(base)), Nat.add(x, U32.to_nat(base)), U32.to_nat(U32.add(base, U32.from_nat(x))), {==},
            Le.rw(Nat.add(x, U32.to_nat(base)), Nat.add(x, U32.to_nat(base)), U32.to_nat(U32.add(base, U32.from_nat(x))), Equal.sym(Nat, U32.to_nat(U32.add(base, U32.from_nat(x))), Nat.add(x, U32.to_nat(base)), hx),
              Shared.Nat.is_le_refl(Nat.add(x, U32.to_nat(base))))), h4,
          Ldr.at(rest, x, mem, base, size, hfit, hxs)))
