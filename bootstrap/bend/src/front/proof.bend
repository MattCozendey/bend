# The defs of a text of at most L bytes need at most one fuel each, and one more.
def Defs.enough(+n: Nat, +f: Nat, +L: Nat, +F: Nat, +G: Nat, +hF: {Nat.is_le(1n+L, F) == True{} : Bool}, +hG: {Nat.is_le(1n+Nat.double(L), G) == True{} : Bool}) ->
  Le(List<&2, Source.Def>, Source.Book.parse_defs(n, f), Source.Book.parse_defs(F, G), L, False{}):
  match n:
    case 0n:
      s => hl => Unit{}
    case 1n+m:
      match L:
        case 0n:
          match F:
            case 0n:
              Shared.Bool.absurd(Le(List<&2, Source.Def>, Source.Book.parse_defs(1n+m, f), Source.Book.parse_defs(0n, G), 0n, False{}), hF)
            case 1n+E:
              +s => hl => Lst.elim(s, xs => {Nat.is_le(List.length(&2, Nat, xs), 0n) == True{} : Bool} -> Res.Le(List<&2, Source.Def>, Source.Book.parse_defs(1n+m, f)(xs),
                Source.Book.parse_defs(1n+E, G)(xs), xs, False{}),
                h => ({==}, {==}), b => r => h => Shared.Bool.absurd(Res.Le(List<&2, Source.Def>, Source.Book.parse_defs(1n+m, f)(Con{b, r}),
                Source.Book.parse_defs(1n+E, G)(Con{b, r}), Con{b, r}, False{}), h))(hl)
        case 1n+M:
          match F:
            case 0n:
              Shared.Bool.absurd(Le(List<&2, Source.Def>, Source.Book.parse_defs(1n+m, f), Source.Book.parse_defs(0n, G), 1n+M, False{}), hF)
            case 1n+E:
              Le.bind(Bool, List<&2, Source.Def>, Source.Book.parse_defs.end, Source.Book.parse_defs.end, e => Source.Bool.if(Source.Parse(List<&2, Source.Def>), e, Source.Parse.pure(List<&2, Source.Def>, []), Source.Book.parse_def(f, Source.Book.parse_defs(m, f))), e => Source.Bool.if(Source.Parse(List<&2, Source.Def>), e,
                Source.Parse.pure(List<&2, Source.Def>, []), Source.Book.parse_def(G, Source.Book.parse_defs(E, G))), 1n+M, False{}, False{}, End.le(1n+M),
                +e => Le.if(List<&2, Source.Def>, e, Source.Parse.pure(List<&2, Source.Def>, []), Source.Parse.pure(List<&2, Source.Def>, []), Source.Book.parse_def(f, Source.Book.parse_defs(m, f)),
                  Source.Book.parse_def(G, Source.Book.parse_defs(E, G)), 1n+M, False{}, Le.pure(List<&2, Source.Def>, [], 1n+M),
                  Le.unstrict(List<&2, Source.Def>, Source.Book.parse_def(f, Source.Book.parse_defs(m, f)), Source.Book.parse_def(G, Source.Book.parse_defs(E, G)), 1n+M,
                    Def.le(f, G, m, E, 1n+M, Parse.enough(f, Source.Mode.term{}, [], M, G, Shared.Nat.is_le_pred(1n+Nat.double(M), G, Shared.Nat.is_le_pred(1n+1n+Nat.double(M), G, hG))),
                      Parse.enough(f, Source.Mode.term{}, [], M, G, Shared.Nat.is_le_pred(1n+Nat.double(M), G, Shared.Nat.is_le_pred(1n+1n+Nat.double(M), G, hG))), Defs.enough(m, f, M, E, G, hF, Shared.Nat.is_le_pred(1n+Nat.double(M), G, Shared.Nat.is_le_pred(1n+1n+Nat.double(M), G, hG)))))))

# Law
# ===

# Book.parse after the parse of its defs gave x
def Law.of(x: Source.Parsed<List<&2, Source.Def>>, -y: Source.Parsed<List<&2, Source.Def>>, -bk: List<&2, Source.Def>, -src: List<&2, Nat>, rel: Res.Le(List<&2, Source.Def>, x, y, src, False{}),
  h: {Source.Book.parse.of(x) == Some{bk} : Maybe<&2, List<&2, Source.Def>>}) -> {Source.Book.parse.of(y) == Some{bk} : Maybe<&2, List<&2, Source.Def>>}:
  match x:
    case Source.Parsed.ok{v, r}:
      (e, t) = rel
      %Equal.sym(Source.Parsed<List<&2, Source.Def>>, y, Source.Parsed.ok{v, r}, e) : {Source.Book.parse.of(_) == Some{bk} : Maybe<&2, List<&2, Source.Def>>}
      h
    case Source.Parsed.fail{}:
      Empty.absurd({Source.Book.parse.of(y) == Some{bk} : Maybe<&2, List<&2, Source.Def>>}, Shared.Maybe.no_none(List<&2, Source.Def>, bk, h))

# the law, with its parameters reusable
def Law.above(+n: Nat, +k: Nat, +src: List<&2, Nat>, -bk: List<&2, Source.Def>, h: {Source.Book.parse(n, src) == Some{bk} : Maybe<&2, List<&2, Source.Def>>}) ->
  {Source.Book.parse(Nat.add(Front.Front.fuel(src), k), src) == Some{bk} : Maybe<&2, List<&2, Source.Def>>}:
  Law.of(Source.Book.parse_defs(n, n, src), Source.Book.parse_defs(Nat.add(Front.Front.fuel(src), k), Nat.add(Front.Front.fuel(src), k), src), bk, src,
    Defs.enough(n, n, List.length(&2, Nat, src), Nat.add(Front.Front.fuel(src), k), Nat.add(Front.Front.fuel(src), k),
      Shared.Nat.is_le_succ(List.length(&2, Nat, src), Nat.add(Nat.double(List.length(&2, Nat, src)), k), Shared.Nat.is_le_trans(List.length(&2, Nat, src), Nat.double(List.length(&2, Nat, src)),
        Nat.add(Nat.double(List.length(&2, Nat, src)), k), Shared.Nat.is_le_double(List.length(&2, Nat, src)), Shared.Nat.is_le_add(Nat.double(List.length(&2, Nat, src)), k))),
      Shared.Nat.is_le_succ(Nat.double(List.length(&2, Nat, src)), Nat.add(Nat.double(List.length(&2, Nat, src)), k), Shared.Nat.is_le_add(Nat.double(List.length(&2, Nat, src)), k)))(src,
      Shared.Nat.is_le_refl(List.length(&2, Nat, src))), h)

def Spec.parse_above(n, k, src, bk, h):
  Law.above(n, k, src, bk, h)
