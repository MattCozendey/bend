def AS.y(s: AS) -> U32:
  match s:
    case AS{hp, y, q, acc, a, i, w, mem}:
      y

def AS.q(s: AS) -> U32:
  match s:
    case AS{hp, y, q, acc, a, i, w, mem}:
      q

def AS.a(s: AS) -> U32:
  match s:
    case AS{hp, y, q, acc, a, i, w, mem}:
      a

def AS.i(s: AS) -> U32:
  match s:
    case AS{hp, y, q, acc, a, i, w, mem}:
      i

def AS.w(s: AS) -> U32:
  match s:
    case AS{hp, y, q, acc, a, i, w, mem}:
      w

def AS.ls_eq(s: AS, +x1: U32, +x2: U32, +x3: U32, +x4: U32, +x5: U32, +x6: U32, +x7: U32, +x8: U32, +x9: U32, +x10: U32, +x12: U32) -> {AS.ls(s, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x12) == L(AS.hp(s), x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, AS.y(s), x12, AS.q(s), AS.acc(s), AS.a(s), AS.i(s), AS.w(s)) : List<&2, U32>}:
  match s:
    case AS{hp, y, q, acc, a, i, w, mem}:
      {==}

def Nat.add_swap(+M: Nat, +K: Nat, +H: Nat) -> {Nat.add(Nat.add(M, K), H) == Nat.add(K, Nat.add(M, H)) : Nat}:
  Equal.trans(Nat, Nat.add(Nat.add(M, K), H), Nat.add(Nat.add(K, M), H), Nat.add(K, Nat.add(M, H)),
    Equal.cong(Nat, Nat, x => Nat.add(x, H), Nat.add(M, K), Nat.add(K, M), MP.Nat.add_comm(M, K)), MP.Nat.add_assoc(K, M, H))

def Nat.add_s12(+M: Nat, +H: Nat) -> {Nat.add(M, 12n+H) == Nat.add(12n, Nat.add(M, H)) : Nat}:
  Equal.trans(Nat, Nat.add(M, 12n+H), Nat.add(Nat.add(M, 12n), H), Nat.add(12n, Nat.add(M, H)),
    Equal.sym(Nat, Nat.add(Nat.add(M, 12n), H), Nat.add(M, 12n+H), MP.Nat.add_assoc(M, 12n, H)), Nat.add_swap(M, 12n, H))

def Rev.len(xs: List<&2, Fun.A>, +us: List<&2, Fun.A>) ->
  {List.length(&2, Fun.A, Rev(xs, us)) == Nat.add(List.length(&2, Fun.A, xs), List.length(&2, Fun.A, us)) : Nat}:
  match xs:
    case Nil{}:
      {==}
    case Con{+x, +rest}:
      Equal.trans(Nat, List.length(&2, Fun.A, Rev(rest, Con{x, us})), Nat.add(List.length(&2, Fun.A, rest), 1n+List.length(&2, Fun.A, us)),
        1n+Nat.add(List.length(&2, Fun.A, rest), List.length(&2, Fun.A, us)), Rev.len(rest, Con{x, us}),
        MP.Nat.add_succ(List.length(&2, Fun.A, rest), List.length(&2, Fun.A, us)))

# the program has the function f when f is below its length
def Get.lt(cs: List<&2, Fun.C>, f: Nat, +h: {Nat.is_lt(f, List.length(&2, Fun.C, cs)) == True{} : Bool},
  +hm: {List.get(&2, Fun.C, cs, f) == None{} : Maybe<&2, Fun.C>}) -> Empty:
  match cs f:
    case Nil{} _:
      Shared.Bool.no(Equal.trans(Bool, False{}, Nat.is_lt(f, 0n), True{}, Equal.sym(Bool, Nat.is_lt(f, 0n), False{}, MP.Nat.is_lt_zero(f)), h))
    case Con{c, rest} 0n:
      Shared.Maybe.no_none(Fun.C, c, Equal.sym(Maybe<&2, Fun.C>, Some{c}, None{}, hm))
    case Con{c, rest} 1n+p:
      Get.lt(rest, p, h, hm)

def Get.ge(cs: List<&2, Fun.C>, f: Nat, -k: Fun.C, +h: {Nat.is_lt(f, List.length(&2, Fun.C, cs)) == False{} : Bool},
  +hm: {List.get(&2, Fun.C, cs, f) == Some{k} : Maybe<&2, Fun.C>}) -> Empty:
  match cs f:
    case Nil{} _:
      Shared.Maybe.no_none(Fun.C, k, hm)
    case Con{c, rest} 0n:
      Shared.Bool.no(Equal.sym(Bool, True{}, False{}, h))
    case Con{c, rest} 1n+p:
      Get.ge(rest, p, k, h, hm)

def Mb.c(m: Maybe<&2, Fun.C>) -> Fun.C:
  match m:
    case Some{c}:
      c
    case None{}:
      Fun.C.stop{}

# the code of the function i of a table, from base
def Tab.at(c: Fun.C, +i: Nat, +len: Nat, +mem: Wasm.Mem, +hp: Nat, +base: U32) -> Bool:
  Bool.and(Nat.is_le(4n+Nat.add(U32.to_nat(base), Nat.double(Nat.double(i))), hp),
    Rd(RT.Enc.code(c, len), mem, hp, Wasm.Mem.load(U32.add(base, U32.from_nat(Nat.double(Nat.double(i)))), mem)))

def Tab.get(cs: List<&2, Fun.C>, j: Nat, +i: Nat, -c: Fun.C, +len: Nat, +mem: Wasm.Mem, +hp: Nat, +base: U32,
  +h: {Tab(cs, i, len, mem, hp, base) == True{} : Bool}, +hm: {List.get(&2, Fun.C, cs, j) == Some{c} : Maybe<&2, Fun.C>}) ->
  {Tab.at(c, Nat.add(j, i), len, mem, hp, base) == True{} : Bool}:
  match cs j:
    case Nil{} _:
      Empty.absurd({Tab.at(c, Nat.add(j, i), len, mem, hp, base) == True{} : Bool}, Shared.Maybe.no_none(Fun.C, c, hm))
    case Con{+d, +rest} 0n:
      %hm : {Tab.at(Mb.c(_), i, len, mem, hp, base) == True{} : Bool}
      And.mk(Nat.is_le(4n+Nat.add(U32.to_nat(base), Nat.double(Nat.double(i))), hp),
        Rd(RT.Enc.code(d, len), mem, hp, Wasm.Mem.load(U32.add(base, U32.from_nat(Nat.double(Nat.double(i)))), mem)),
        And.l(Nat.is_le(4n+Nat.add(U32.to_nat(base), Nat.double(Nat.double(i))), hp),
          Bool.and(Rd(RT.Enc.code(d, len), mem, hp, Wasm.Mem.load(U32.add(base, U32.from_nat(Nat.double(Nat.double(i)))), mem)),
            Tab(rest, 1n+i, len, mem, hp, base)), h),
        And.l(Rd(RT.Enc.code(d, len), mem, hp, Wasm.Mem.load(U32.add(base, U32.from_nat(Nat.double(Nat.double(i)))), mem)),
          Tab(rest, 1n+i, len, mem, hp, base),
          And.r(Nat.is_le(4n+Nat.add(U32.to_nat(base), Nat.double(Nat.double(i))), hp),
            Bool.and(Rd(RT.Enc.code(d, len), mem, hp, Wasm.Mem.load(U32.add(base, U32.from_nat(Nat.double(Nat.double(i)))), mem)),
              Tab(rest, 1n+i, len, mem, hp, base)), h)))
    case Con{+d, +rest} 1n++p:
      %MP.Nat.add_succ(p, i) : {Tab.at(c, _, len, mem, hp, base) == True{} : Bool}
      Tab.get(rest, p, 1n+i, c, len, mem, hp, base,
        And.r(Rd(RT.Enc.code(d, len), mem, hp, Wasm.Mem.load(U32.add(base, U32.from_nat(Nat.double(Nat.double(i)))), mem)),
          Tab(rest, 1n+i, len, mem, hp, base),
          And.r(Nat.is_le(4n+Nat.add(U32.to_nat(base), Nat.double(Nat.double(i))), hp),
            Bool.and(Rd(RT.Enc.code(d, len), mem, hp, Wasm.Mem.load(U32.add(base, U32.from_nat(Nat.double(Nat.double(i)))), mem)),
              Tab(rest, 1n+i, len, mem, hp, base)), h)), hm)

def Rd.pick_t(+c: Bool, -A: Fun.V, -B: Fun.V, +mem: Wasm.Mem, +hp: Nat, +p: U32, +hb: {c == True{} : Bool},
  +h: {Rd(Bool.pick(Fun.V, c, A, B), mem, hp, p) == True{} : Bool}) -> {Rd(A, mem, hp, p) == True{} : Bool}:
  %hb : {Rd(Bool.pick(Fun.V, _, A, B), mem, hp, p) == True{} : Bool}
  h

def Rd.pick_f(+c: Bool, -A: Fun.V, -B: Fun.V, +mem: Wasm.Mem, +hp: Nat, +p: U32, +hb: {c == False{} : Bool},
  +h: {Rd(Bool.pick(Fun.V, c, A, B), mem, hp, p) == True{} : Bool}) -> {Rd(B, mem, hp, p) == True{} : Bool}:
  %hb : {Rd(Bool.pick(Fun.V, _, A, B), mem, hp, p) == True{} : Bool}
  h

# a word at p, below the end of the memory
def Ad0w(+p: U32, +size: U32, +h: {Nat.is_le(4n+U32.to_nat(p), U32.to_nat(size)) == True{} : Bool}) ->
  {Wasm.Mem.addr(p, 0, 4, size) == Some{p} : Maybe<&2, U32>}:
  %WP.U.add_zero(p) : {Wasm.Mem.addr(p, 0, 4, size) == Some{_} : Maybe<&2, U32>}
  Addr(p, 0, 4, size,
    %Nat.add_add(U32.to_nat(p), 0n, 4n) : {Nat.is_le(_, U32.to_nat(size)) == True{} : Bool}
    h)

# Args.some, with the locals after the loop as a list
def Args.run(+ys: List<&2, Fun.A>, +n: Nat, +env: List<&2, Fun.V>, +hp: U32, +x1: U32, +x2: U32, +x3: U32, +x4: U32, +x5: U32, +x6: U32, +x7: U32, +x8: U32, +x9: U32, +x10: U32, +x12: U32, +y0: U32, +q: U32, +acc: U32, +t15: U32,
  +t16: U32, +w: U32, +mem: Wasm.Mem, +size: U32, +H: Nat, +hH: {U32.to_nat(hp) == H : Nat},
  +hq: {Rd(Enc.atoms(ys), mem, H, q) == True{} : Bool}, +hv: {Rd(RT.Enc.list(env), mem, H, x4) == True{} : Bool},
  +hz: {Nat.is_le(1n, H) == True{} : Bool}, +hr: {Nat.is_le(Args.top(ys, H), U32.to_nat(size)) == True{} : Bool},
  +hs: {Nat.is_le(H, U32.to_nat(size)) == True{} : Bool}, +hn: {Nat.is_le(Args.need(ys), n) == True{} : Bool},
  +hall: {Args.all(ys, env) == True{} : Bool}) ->
  {Imp.Stm.run(Imp.Stm.loop{RT.S.args.body()}, n, size, L(hp, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, y0, x12, q, acc, t15, t16, w), mem) == Some{Imp.Res.next{L(AS.hp(AS.run(ys, AS{hp, y0, q, acc, t15, t16, w, mem}, x4)), x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, AS.y(AS.run(ys, AS{hp, y0, q, acc, t15, t16, w, mem}, x4)), x12, AS.q(AS.run(ys, AS{hp, y0, q, acc, t15, t16, w, mem}, x4)), AS.acc(AS.run(ys, AS{hp, y0, q, acc, t15, t16, w, mem}, x4)), AS.a(AS.run(ys, AS{hp, y0, q, acc, t15, t16, w, mem}, x4)), AS.i(AS.run(ys, AS{hp, y0, q, acc, t15, t16, w, mem}, x4)), AS.w(AS.run(ys, AS{hp, y0, q, acc, t15, t16, w, mem}, x4))), AS.mem(AS.run(ys, AS{hp, y0, q, acc, t15, t16, w, mem}, x4))}} : Maybe<&2, Imp.Res>}:
  %AS.ls_eq(AS.run(ys, AS{hp, y0, q, acc, t15, t16, w, mem}, x4), x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x12) :
    {Imp.Stm.run(Imp.Stm.loop{RT.S.args.body()}, n, size, L(hp, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, y0, x12, q, acc, t15, t16, w), mem) == Some{Imp.Res.next{_, AS.mem(AS.run(ys, AS{hp, y0, q, acc, t15, t16, w, mem}, x4))}} : Maybe<&2, Imp.Res>}
  Args.some(ys, n, env, hp, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x12, y0, q, acc, t15, t16, w, mem, size, H, hH, hq, hv, hz, hr, hs, hn, hall)


def Args.top_eq(ys: List<&2, Fun.A>, +H: Nat) -> {Args.top(ys, H) == Nat.add(Nat.mul(List.length(&2, Fun.A, ys), 12n), H) : Nat}:
  match ys:
    case Nil{}:
      {==}
    case Con{y, +rest}:
      Equal.trans(Nat, Args.top(rest, 12n+H), Nat.add(Nat.mul(List.length(&2, Fun.A, rest), 12n), 12n+H),
        Nat.add(Nat.mul(1n+List.length(&2, Fun.A, rest), 12n), H), Args.top_eq(rest, 12n+H),
        Nat.add_s12(Nat.mul(List.length(&2, Fun.A, rest), 12n), H))

# jump
def P.jump.m(m: Maybe<&2, Fun.C>, b: Bool, +f: Nat, +xs: List<&2, Fun.A>, +env: List<&2, Fun.V>, +ks: List<&2, Fun.Fr>, +n: Nat, +prog: List<&2, Fun.C>, +size: U32, +x0: U32, +x1: U32, +x2: U32, +x3: U32, +x4: U32, +x5: U32, +x6: U32, +x7: U32, +x8: U32, +x9: U32, +x10: U32, +x11: U32, +x12: U32, +x13: U32, +x14: U32, +x15: U32, +x16: U32, +x17: U32, +mem: Wasm.Mem,
  +hm: {List.get(&2, Fun.C, prog, f) == m : Maybe<&2, Fun.C>}, +hb: {Nat.is_lt(f, List.length(&2, Fun.C, prog)) == b : Bool},
  +hinv: {Inv.s(Fun.S.run{Fun.C.jump{f, xs}, env, ks}, x0, x1, x2, x3, x4, x5, x6, x7, mem, prog, size) == True{} : Bool}, +hn: {Nat.is_le(Args.need(Rev(xs, [])), n) == True{} : Bool}) ->
  {Pass.ok(Fun.Step.call(m, Fun.As.get(xs, env), ks), Imp.Stm.run(RT.I.step(), n, size, L(x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15, x16, x17), mem), prog, size) == True{} : Bool}:
  match m b:
    case Some{+cf} True{}:
      +hic = Inv.run.ic(Fun.C.jump{f, xs}, env, ks, x0, x1, x2, x3, x4, x5, x6, x7, mem, prog, size, hinv)
      +hmode = Inv.run.mode(Fun.C.jump{f, xs}, env, ks, x0, x1, x2, x3, x4, x5, x6, x7, mem, prog, size, hinv)
      +hc0 = Inv.run.c(Fun.C.jump{f, xs}, env, ks, x0, x1, x2, x3, x4, x5, x6, x7, mem, prog, size, hinv)
      +henv = Inv.run.env(Fun.C.jump{f, xs}, env, ks, x0, x1, x2, x3, x4, x5, x6, x7, mem, prog, size, hinv)
      +hks = Inv.run.ks(Fun.C.jump{f, xs}, env, ks, x0, x1, x2, x3, x4, x5, x6, x7, mem, prog, size, hinv)
      +hz = Inv.c.hz(x0, x1, x2, mem, prog, size, hic)
      +hl = Inv.c.hl(x0, x1, x2, mem, prog, size, hic)
      +hls = Inv.c.ls(x0, x1, x2, mem, prog, size, hic)
      +hs5 = Inv.c.s5(x0, x1, x2, mem, prog, size, hic)
      +htab = Inv.c.tab(x0, x1, x2, mem, prog, size, hic)
      +hs = Le.t(U32.to_nat(x0), U32.to_nat(x1), U32.to_nat(size), hl, hls)
      +hc6 = Rd.pick_t(Nat.is_lt(f, List.length(&2, Fun.C, prog)), Fun.V.n{7n, Fun.V.n{Nat.double(Nat.double(f)), RT.Enc.args(xs, Fun.V.z{}), Fun.V.num(Nat.add(Nat.mul(List.length(&2, Fun.A, xs), 12n), 0n))}, Fun.V.z{}}, Fun.V.num(8n), mem, U32.to_nat(x0), x3, hb, hc0)
      Shared.Bool.elim(Nat.is_lt(Nat.sub(U32.to_nat(x1), U32.to_nat(x0)), U32.to_nat(U32.from_nat(Nat.add(Nat.mul(List.length(&2, Fun.A, xs), 12n), 0n)))), bb => {Nat.is_lt(Nat.sub(U32.to_nat(x1), U32.to_nat(x0)), U32.to_nat(U32.from_nat(Nat.add(Nat.mul(List.length(&2, Fun.A, xs), 12n), 0n)))) == bb : Bool} -> {Pass.ok(Fun.Step.call(Some{cf}, Fun.As.get(xs, env), ks), Imp.Stm.run(RT.I.step(), n, size, L(x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15, x16, x17), mem), prog, size) == True{} : Bool},
              +hok =>
                %Equal.sym(Maybe<&2, Imp.Res>, Imp.Stm.run(RT.I.step(), n, size, L(x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15, x16, x17), mem), Some{Imp.Res.brk{1n, L(x0, x1, x2, x3, x4, x5, x6, x7, 0, U32.from_nat(Nat.add(Nat.mul(List.length(&2, Fun.A, xs), 12n), 0n)), Wasm.Mem.load(U32.add(x3, 4), mem), x11, x12, x13, x14, x15, x16, x17), Oom.mem(mem)}},
