                    Parse.enough(m, Source.Mode.tup{}, vs, M, G, Shared.Nat.is_le_pred(1n+1n+Nat.double(M), G, hF)))
        case Source.Mode.args{+f}:
          match L:
            case 0n:
              Nil.mode.le(m, Source.Mode.args{f}, vs, F)
            case 1n+M:
              match F:
                case 0n:
                  Shared.Bool.absurd(Le(Source.Term, Source.Term.parse(1n+m, Source.Mode.args{f}, vs), Source.Term.parse(0n, Source.Mode.args{f}, vs), 1n+M, True{}), hF)
                case 1n+G:
                  Args.le(f, m, G, vs, 1n+M, Parse.enough(m, Source.Mode.term{}, vs, 1n+M, G, hF),
                    g => Parse.enough(m, Source.Mode.args{g}, vs, M, G, Shared.Nat.is_le_pred(1n+1n+Nat.double(M), G, hF)))

def Res.unstrict(-A: Data, x: Source.Parsed<A>, -y: Source.Parsed<A>, +s: List<&2, Nat>, h: Res.Le(A, x, y, s, True{})) ->
  Res.Le(A, x, y, s, False{}):
  match x:
    case Source.Parsed.ok{v, +r}:
      (e, t) = h
      (e, Rest.weak(True{}, r, s, t))
    case Source.Parsed.fail{}:
      Unit{}

def Le.unstrict(-A: Data, p: Source.Parse(A), q: Source.Parse(A), L: Nat, r: Le(A, p, q, L, True{})) -> Le(A, p, q, L, False{}):
  +s => hl => Res.unstrict(A, p(s), q(s), s, r(s, hl))

def End.le(L: Nat) -> Le(Bool, Source.Book.parse_defs.end, Source.Book.parse_defs.end, L, False{}):
  +s => hl => Lst.elim(Source.Parse.gap(s, False{}),
    g => {Nat.is_le(List.length(&2, Nat, g), List.length(&2, Nat, s)) == True{} : Bool} -> Res.Le(Bool, Source.Book.parse_defs.end.of(g),
      Source.Book.parse_defs.end.of(g), s, False{}),
    h => ({==}, Shared.Nat.is_le_zero(List.length(&2, Nat, s))),
    b => r => h => ({==}, h))(Gap.le(s, False{}))

