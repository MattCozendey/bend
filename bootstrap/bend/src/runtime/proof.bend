# the tag of a node, as a constant
def E.tag(+e: Imp.Exp, +size: U32, +ls: List<&2, U32>, +mem: Wasm.Mem, +p: U32, +H: Nat, +t: Nat, +a: Fun.V, +b: Fun.V,
  he: {Imp.Exp.eval(e, size, ls, mem) == Some{p} : Maybe<&2, U32>}, +h: {Rd(Fun.V.n{t, a, b}, mem, H, p) == True{} : Bool},
  +hs: {Nat.is_le(H, U32.to_nat(size)) == True{} : Bool}) ->
  {Imp.Exp.eval(RT.E.ld(0, e), size, ls, mem) == Some{U32.from_nat(t)} : Maybe<&2, U32>}:
  %Tag.lit(p, mem, t, Rd.tag(mem, H, p, t, a, b, h)) :
    {Imp.Exp.eval(RT.E.ld(0, e), size, ls, mem) == Some{_} : Maybe<&2, U32>}
  E.load(0, e, size, ls, mem, p, p, he, Ad0(p, H, size, Rd.hi(mem, H, p, t, a, b, h), hs))

# the tag of a node fits in an i32
def Tag.fits(+p: U32, +mem: Wasm.Mem, +H: Nat, +t: Nat, +a: Fun.V, +b: Fun.V, +h: {Rd(Fun.V.n{t, a, b}, mem, H, p) == True{} : Bool}) ->
  {Nat.is_eq(U32.to_nat(U32.from_nat(t)), t) == True{} : Bool}:
  %Nat.eq_of(U32.to_nat(Wasm.Mem.load(p, mem)), t, Rd.tag(mem, H, p, t, a, b, h)) :
    {Nat.is_eq(U32.to_nat(U32.from_nat(_)), _) == True{} : Bool}
  %Equal.sym(Nat, U32.to_nat(U32.from_nat(U32.to_nat(Wasm.Mem.load(p, mem)))), U32.to_nat(Wasm.Mem.load(p, mem)),
    WP.Fits.to_nat(Wasm.Mem.load(p, mem))) : {Nat.is_eq(_, U32.to_nat(Wasm.Mem.load(p, mem))) == True{} : Bool}
  WP.Nat.is_eq_refl(U32.to_nat(Wasm.Mem.load(p, mem)))

# hp + k, for a constant k
def H.add(+hp: U32, +H: Nat, +k: U32, +hH: {U32.to_nat(hp) == H : Nat}, +size: U32,
  +h: {Nat.is_le(Nat.add(U32.to_nat(k), H), U32.to_nat(size)) == True{} : Bool}) ->
  {U32.to_nat(U32.add(hp, k)) == Nat.add(U32.to_nat(k), H) : Nat}:
  %hH : {U32.to_nat(U32.add(hp, k)) == Nat.add(U32.to_nat(k), _) : Nat}
  U.add_lit(hp, k, Fits.le(Nat.add(U32.to_nat(k), U32.to_nat(hp)), size,
    %Equal.sym(Nat, U32.to_nat(hp), H, hH) : {Nat.is_le(Nat.add(U32.to_nat(k), _), U32.to_nat(size)) == True{} : Bool}
    h))

# the output of Out.oom
def Oom.out(+mem: Wasm.Mem, +size: U32, +hs: {Nat.is_le(5n, U32.to_nat(size)) == True{} : Bool}) ->
  {Wasm.Halted.output(Some{Wasm.Halted{0, Oom.mem(mem)}}, size) == Some{[255n]} : Maybe<&2, List<&2, Nat>>}:
  %Equal.sym(Maybe<&2, U32>, Wasm.Mem.addr(0, 0, 4, size), Some{0}, Addr(0, 0, 4, size, Shared.Nat.is_le_pred(4n, U32.to_nat(size), hs))) :
    {Wasm.Halted.output.of(0, Oom.mem(mem), size, _) == Some{[255n]} : Maybe<&2, List<&2, Nat>>}
  %Equal.sym(Maybe<&2, U32>, Wasm.Mem.addr(0, 4, 1, size), Some{4}, Addr(0, 4, 1, size, hs)) :
    {Wasm.Halted.output.at(_, 1, Oom.mem(mem)) == Some{[255n]} : Maybe<&2, List<&2, Nat>>}
  {==}

# a pass that ends with Out.oom
def Pass.oom(+x: Fun.Step, +ls: List<&2, U32>, +m: Wasm.Mem, +prog: List<&2, Fun.C>, +size: U32,
  +he: {Fin(ls, Oom.mem(m), size) == Some{[255n]} : Maybe<&2, List<&2, Nat>>}) ->
  {Pass.ok(x, Some{Imp.Res.brk{1n, ls, Oom.mem(m)}}, prog, size) == True{} : Bool}:
  %Equal.sym(Maybe<&2, List<&2, Nat>>, Fin(ls, Oom.mem(m), size), Some{[255n]}, he) :
    {Bool.or(Out.is_oom(_), Halt.ok(x, _)) == True{} : Bool}
  {==}

# a load below hp, after two nodes at hp and hp + 12
def Ld.keep2(+p: U32, +mem: Wasm.Mem, +hp: U32, +H: Nat, +hH: {U32.to_nat(hp) == H : Nat}, +t1: U32, +a1: U32, +b1: U32,
  +t2: U32, +a2: U32, +b2: U32, +size: U32, +hr: {Nat.is_le(24n+H, U32.to_nat(size)) == True{} : Bool},
  +hp4: {Nat.is_le(4n+U32.to_nat(p), H) == True{} : Bool}) ->
  {Wasm.Mem.load(p, M3(U32.add(hp, 12), M3(hp, mem, t1, a1, b1), t2, a2, b2)) == Wasm.Mem.load(p, mem) : U32}:
  +m1 = M3(hp, mem, t1, a1, b1)
  +hr1 = Le.t(12n+H, 24n+H, U32.to_nat(size), Shared.Nat.is_le_add_left(12n+H, 12n), hr)
  +hH1 = H.add(hp, H, 12, hH, size, hr1)
  Equal.trans(U32, Wasm.Mem.load(p, M3(U32.add(hp, 12), m1, t2, a2, b2)), Wasm.Mem.load(p, m1), Wasm.Mem.load(p, mem),
    Ld.keep(p, m1, U32.add(hp, 12), t2, a2, b2, size,
      %Equal.sym(Nat, U32.to_nat(U32.add(hp, 12)), 12n+H, hH1) : {Nat.is_le(12n+_, U32.to_nat(size)) == True{} : Bool}
      hr,
      %Equal.sym(Nat, U32.to_nat(U32.add(hp, 12)), 12n+H, hH1) : {Nat.is_le(4n+U32.to_nat(p), _) == True{} : Bool}
      Le.t(4n+U32.to_nat(p), H, 12n+H, hp4, Shared.Nat.is_le_add_left(H, 12n))),
    Ld.keep(p, mem, hp, t1, a1, b1, size,
      %Equal.sym(Nat, U32.to_nat(hp), H, hH) : {Nat.is_le(12n+_, U32.to_nat(size)) == True{} : Bool}
      hr1,
      %Equal.sym(Nat, U32.to_nat(hp), H, hH) : {Nat.is_le(4n+U32.to_nat(p), _) == True{} : Bool}
      hp4))

# a value below hp, after two nodes at hp and hp + 12
def Rd.keep2(+v: Fun.V, +mem: Wasm.Mem, +p: U32, +hp: U32, +H: Nat, +hH: {U32.to_nat(hp) == H : Nat}, +t1: U32, +a1: U32,
  +b1: U32, +t2: U32, +a2: U32, +b2: U32, +size: U32, +hr: {Nat.is_le(24n+H, U32.to_nat(size)) == True{} : Bool},
  +h: {Rd(v, mem, H, p) == True{} : Bool}) ->
  {Rd(v, M3(U32.add(hp, 12), M3(hp, mem, t1, a1, b1), t2, a2, b2), 24n+H, p) == True{} : Bool}:
  +hr1 = Le.t(12n+H, 24n+H, U32.to_nat(size), Shared.Nat.is_le_add_left(12n+H, 12n), hr)
  Rd.keepH(v, M3(hp, mem, t1, a1, b1), p, U32.add(hp, 12), 12n+H, H.add(hp, H, 12, hH, size, hr1), t2, a2, b2, size, hr,
    Rd.keepH(v, mem, p, hp, H, hH, t1, a1, b1, size, hr1, h))

def Tab.keep2(+cs: List<&2, Fun.C>, +len: Nat, +mem: Wasm.Mem, +hp: U32, +H: Nat, +hH: {U32.to_nat(hp) == H : Nat}, +base: U32,
  +t1: U32, +a1: U32, +b1: U32, +t2: U32, +a2: U32, +b2: U32, +size: U32,
  +hr: {Nat.is_le(24n+H, U32.to_nat(size)) == True{} : Bool}, +h: {Tab(cs, 0n, len, mem, H, base) == True{} : Bool}) ->
  {Tab(cs, 0n, len, M3(U32.add(hp, 12), M3(hp, mem, t1, a1, b1), t2, a2, b2), 24n+H, base) == True{} : Bool}:
  +hr1 = Le.t(12n+H, 24n+H, U32.to_nat(size), Shared.Nat.is_le_add_left(12n+H, 12n), hr)
  Tab.keep(cs, 0n, len, M3(hp, mem, t1, a1, b1), U32.add(hp, 12), 12n+H, H.add(hp, H, 12, hH, size, hr1), base, t2, a2, b2,
    size, hr, Tab.keep(cs, 0n, len, mem, hp, H, hH, base, t1, a1, b1, size, hr1, h))

# the fuel of a step of the abstract machine at c
def Need.c(c: Fun.C) -> Nat:
  match c:
    case Fun.C.ret{a}:
      1n+Atom.need(a)
    case Fun.C.mk{t, a, b, k}:
      Nat.add(1n+Atom.need(a), 1n+Atom.need(b))
    case Fun.C.case{a, t, y, n}:
      1n+Atom.need(a)
    case Fun.C.same{a, b, y, n}:
      Nat.add(1n+Atom.need(a), 1n+Atom.need(b))
    case Fun.C.dec{a, z, s}:
      1n+Atom.need(a)
    case Fun.C.inc{a, k}:
      1n+Atom.need(a)
    case Fun.C.call{f, xs, k}:
      Args.need(Rev(xs, []))
    case Fun.C.jump{f, xs}:
      Args.need(Rev(xs, []))
    case Fun.C.stop{}:
      0n

# the condition of the comparison of two tags
def Cond.tags(+p1: U32, +p2: U32, +mem: Wasm.Mem, +u: Nat, +t: Nat,
  +h1: {Nat.is_eq(U32.to_nat(Wasm.Mem.load(p1, mem)), u) == True{} : Bool},
  +h2: {Nat.is_eq(U32.to_nat(Wasm.Mem.load(p2, mem)), t) == True{} : Bool}) ->
  {U32.is_ne(Bool.to_u32(U32.is_eq(Wasm.Mem.load(p1, mem), Wasm.Mem.load(p2, mem))), 0) == Nat.is_eq(u, t) : Bool}:
  +l1 = Wasm.Mem.load(p1, mem)
  +l2 = Wasm.Mem.load(p2, mem)
  %Equal.sym(Cmp, U32.cmp(l1, l2), Nat.cmp(U32.to_nat(l1), U32.to_nat(l2)), WP.U.cmp(l1, l2)) :
    {U32.is_ne(Bool.to_u32(Cmp.is_eq(_)), 0) == Nat.is_eq(u, t) : Bool}
  %Equal.sym(Nat, U32.to_nat(l1), u, Nat.eq_of(U32.to_nat(l1), u, h1)) : {U32.is_ne(Bool.to_u32(Cmp.is_eq(Nat.cmp(_, U32.to_nat(l2)))), 0) == Nat.is_eq(u, t) : Bool}
  %Equal.sym(Nat, U32.to_nat(l2), t, Nat.eq_of(U32.to_nat(l2), t, h2)) : {U32.is_ne(Bool.to_u32(Cmp.is_eq(Nat.cmp(u, _))), 0) == Nat.is_eq(u, t) : Bool}
  Cond.b(Nat.is_eq(u, t))

def U.add_one(+w: U32) -> {U32.add(w, 1) == U32.inc(w) : U32}:
  Equal.trans(U32, U32.add(w, U32.inc(0)), U32.inc(U32.add(w, 0)), U32.inc(w), WP.U.add_inc(w, 0),
    Equal.cong(U32, U32, x => U32.inc(x), U32.add(w, 0), w, WP.U.add_zero(w)))

def Inc.go(r: Nat, +w: U32, +hr: {U32.to_nat(U32.inc(w)) == r : Nat}, +h: {Nat.is_eq(r, 0n) == False{} : Bool}) ->
  {r == 1n+U32.to_nat(w) : Nat}:
  match r:
    case 0n:
      Shared.Bool.absurd({0n == 1n+U32.to_nat(w) : Nat}, Equal.sym(Bool, True{}, False{}, h))
    case 1n+m:
      Equal.cong(Nat, Nat, x => 1n+x, m, U32.to_nat(w), Equal.sym(Nat, U32.to_nat(w), m, WP.U.inc_to_nat(w, m, hr)))

# w + 1, when it is not 0
def Inc.nat(+w: U32, +h: {Nat.is_eq(U32.to_nat(U32.add(w, 1)), 0n) == False{} : Bool}) ->
  {U32.to_nat(U32.add(w, 1)) == 1n+U32.to_nat(w) : Nat}:
  Inc.go(U32.to_nat(U32.add(w, 1)), w,
    %U.add_one(w) : {U32.to_nat(_) == U32.to_nat(U32.add(w, 1)) : Nat}
    {==}, h)

# Steps
# =====

# ret a
def P.ret.m(m: Maybe<&2, Fun.V>, +a: Fun.A, +env: List<&2, Fun.V>, +ks: List<&2, Fun.Fr>, +n: Nat, +prog: List<&2, Fun.C>, +size: U32, +x0: U32, +x1: U32, +x2: U32, +x3: U32, +x4: U32, +x5: U32, +x6: U32, +x7: U32, +x8: U32, +x9: U32, +x10: U32, +x11: U32, +x12: U32, +x13: U32, +x14: U32, +x15: U32, +x16: U32, +x17: U32, +mem: Wasm.Mem, +hm: {Fun.A.get(a, env) == m : Maybe<&2, Fun.V>},
  +hinv: {Inv.s(Fun.S.run{Fun.C.ret{a}, env, ks}, x0, x1, x2, x3, x4, x5, x6, x7, mem, prog, size) == True{} : Bool}, +hn: {Nat.is_le(1n+Atom.need(a), n) == True{} : Bool}) ->
  {Pass.ok(Fun.Step.ret(m, ks), Imp.Stm.run(RT.I.step(), n, size, L(x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15, x16, x17), mem), prog, size) == True{} : Bool}:
  match m:
    case Some{+v}:
      +hic = Inv.run.ic(Fun.C.ret{a}, env, ks, x0, x1, x2, x3, x4, x5, x6, x7, mem, prog, size, hinv)
      +hmode = Inv.run.mode(Fun.C.ret{a}, env, ks, x0, x1, x2, x3, x4, x5, x6, x7, mem, prog, size, hinv)
      +hc = Inv.run.c(Fun.C.ret{a}, env, ks, x0, x1, x2, x3, x4, x5, x6, x7, mem, prog, size, hinv)
      +henv = Inv.run.env(Fun.C.ret{a}, env, ks, x0, x1, x2, x3, x4, x5, x6, x7, mem, prog, size, hinv)
      +hks = Inv.run.ks(Fun.C.ret{a}, env, ks, x0, x1, x2, x3, x4, x5, x6, x7, mem, prog, size, hinv)
      +hz = Inv.c.hz(x0, x1, x2, mem, prog, size, hic)
      +hl = Inv.c.hl(x0, x1, x2, mem, prog, size, hic)
      +hls = Inv.c.ls(x0, x1, x2, mem, prog, size, hic)
      +hs5 = Inv.c.s5(x0, x1, x2, mem, prog, size, hic)
      +htab = Inv.c.tab(x0, x1, x2, mem, prog, size, hic)
      +hs = Le.t(U32.to_nat(x0), U32.to_nat(x1), U32.to_nat(size), hl, hls)
      %Equal.sym(Maybe<&2, Imp.Res>, Imp.Stm.run(RT.I.step(), n, size, L(x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15, x16, x17), mem), Some{Imp.Res.next{L(x0, x1, x2, 0, 0, x5, Atom.val(a, Wasm.Mem.load(U32.add(x3, 4), mem), x4, mem), 1, x8, U32.from_nat(0n), x10, Atom.val(a, Wasm.Mem.load(U32.add(x3, 4), mem), x4, mem), x12, x13, x14, 0, 0, 0), mem}},
        R.if(Imp.Exp.eqz{RT.E.l(7n)}, RT.I.run(), RT.I.back(), n, size, L(x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15, x16, x17), mem, Bool.to_u32(U32.is_eq(x7, 0)), True{}, {Some{Imp.Res.next{L(x0, x1, x2, 0, 0, x5, Atom.val(a, Wasm.Mem.load(U32.add(x3, 4), mem), x4, mem), 1, x8, U32.from_nat(0n), x10, Atom.val(a, Wasm.Mem.load(U32.add(x3, 4), mem), x4, mem), x12, x13, x14, 0, 0, 0), mem}} : Maybe<&2, Imp.Res>},
      {==}, Cond.eqz(x7, True{}, hmode),
      R.seq(Imp.Stm.set{9n, RT.E.ld(0, RT.E.l(3n))}, RT.S.all([RT.I.disp()]), n, size, L(x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15, x16, x17), mem, L(x0, x1, x2, x3, x4, x5, x6, x7, x8, U32.from_nat(0n), x10, x11, x12, x13, x14, x15, x16, x17), mem, {Some{Imp.Res.next{L(x0, x1, x2, 0, 0, x5, Atom.val(a, Wasm.Mem.load(U32.add(x3, 4), mem), x4, mem), 1, x8, U32.from_nat(0n), x10, Atom.val(a, Wasm.Mem.load(U32.add(x3, 4), mem), x4, mem), x12, x13, x14, 0, 0, 0), mem}} : Maybe<&2, Imp.Res>},
        R.set(9n, RT.E.ld(0, RT.E.l(3n)), n, size, L(x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15, x16, x17), mem, U32.from_nat(0n), L(x0, x1, x2, x3, x4, x5, x6, x7, x8, U32.from_nat(0n), x10, x11, x12, x13, x14, x15, x16, x17),
          E.tag(RT.E.l(3n), size, L(x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15, x16, x17), mem, x3, U32.to_nat(x0), 0n, RT.Enc.atom(a), Fun.V.z{}, {==}, hc, hs), {==}),
        R.seq(RT.I.disp(), Imp.Stm.skip{}, n, size, L(x0, x1, x2, x3, x4, x5, x6, x7, x8, U32.from_nat(0n), x10, x11, x12, x13, x14, x15, x16, x17), mem, L(x0, x1, x2, 0, 0, x5, Atom.val(a, Wasm.Mem.load(U32.add(x3, 4), mem), x4, mem), 1, x8, U32.from_nat(0n), x10, Atom.val(a, Wasm.Mem.load(U32.add(x3, 4), mem), x4, mem), x12, x13, x14, 0, 0, 0), mem, {Some{Imp.Res.next{L(x0, x1, x2, 0, 0, x5, Atom.val(a, Wasm.Mem.load(U32.add(x3, 4), mem), x4, mem), 1, x8, U32.from_nat(0n), x10, Atom.val(a, Wasm.Mem.load(U32.add(x3, 4), mem), x4, mem), x12, x13, x14, 0, 0, 0), mem}} : Maybe<&2, Imp.Res>},
          R.seq(RT.S.atom(RT.E.ld(4, RT.E.l(3n))), RT.S.all([Imp.Stm.set{6n, RT.E.l(11n)}, Imp.Stm.set{7n, RT.E.k(1)}, Imp.Stm.set{3n, RT.E.k(0)}, Imp.Stm.set{4n, RT.E.k(0)}]), n, size, L(x0, x1, x2, x3, x4, x5, x6, x7, x8, U32.from_nat(0n), x10, x11, x12, x13, x14, x15, x16, x17), mem, L(x0, x1, x2, x3, x4, x5, x6, x7, x8, U32.from_nat(0n), x10, Atom.val(a, Wasm.Mem.load(U32.add(x3, 4), mem), x4, mem), x12, x13, x14, 0, 0, 0), mem, {Some{Imp.Res.next{L(x0, x1, x2, 0, 0, x5, Atom.val(a, Wasm.Mem.load(U32.add(x3, 4), mem), x4, mem), 1, x8, U32.from_nat(0n), x10, Atom.val(a, Wasm.Mem.load(U32.add(x3, 4), mem), x4, mem), x12, x13, x14, 0, 0, 0), mem}} : Maybe<&2, Imp.Res>},
    Atom.some(a, env, RT.E.ld(4, RT.E.l(3n)), x0, x1, x2, x3, x4, x5, x6, x7, x8, U32.from_nat(0n), x10, x11, x12, x13, x14, x15, x16, x17, Wasm.Mem.load(U32.add(x3, 4), mem), mem, size, U32.to_nat(x0), E.load(4, RT.E.l(3n), size, L(x0, x1, x2, x3, x4, x5, x6, x7, x8, U32.from_nat(0n), x10, x11, x12, x13, x14, x15, x16, x17), mem, x3, U32.add(x3, 4), {==}, Ad4(x3, U32.to_nat(x0), size, Rd.hi(mem, U32.to_nat(x0), x3, 0n, RT.Enc.atom(a), Fun.V.z{}, hc), hs)), Rd.a(mem, U32.to_nat(x0), x3, 0n, RT.Enc.atom(a), Fun.V.z{}, hc), henv, hs, n, v, hm, hn),
  R.seq(Imp.Stm.set{6n, RT.E.l(11n)}, RT.S.all([Imp.Stm.set{7n, RT.E.k(1)}, Imp.Stm.set{3n, RT.E.k(0)}, Imp.Stm.set{4n, RT.E.k(0)}]), n, size, L(x0, x1, x2, x3, x4, x5, x6, x7, x8, U32.from_nat(0n), x10, Atom.val(a, Wasm.Mem.load(U32.add(x3, 4), mem), x4, mem), x12, x13, x14, 0, 0, 0), mem, L(x0, x1, x2, x3, x4, x5, Atom.val(a, Wasm.Mem.load(U32.add(x3, 4), mem), x4, mem), x7, x8, U32.from_nat(0n), x10, Atom.val(a, Wasm.Mem.load(U32.add(x3, 4), mem), x4, mem), x12, x13, x14, 0, 0, 0), mem, {Some{Imp.Res.next{L(x0, x1, x2, 0, 0, x5, Atom.val(a, Wasm.Mem.load(U32.add(x3, 4), mem), x4, mem), 1, x8, U32.from_nat(0n), x10, Atom.val(a, Wasm.Mem.load(U32.add(x3, 4), mem), x4, mem), x12, x13, x14, 0, 0, 0), mem}} : Maybe<&2, Imp.Res>},
    R.set(6n, RT.E.l(11n), n, size, L(x0, x1, x2, x3, x4, x5, x6, x7, x8, U32.from_nat(0n), x10, Atom.val(a, Wasm.Mem.load(U32.add(x3, 4), mem), x4, mem), x12, x13, x14, 0, 0, 0), mem, Atom.val(a, Wasm.Mem.load(U32.add(x3, 4), mem), x4, mem), L(x0, x1, x2, x3, x4, x5, Atom.val(a, Wasm.Mem.load(U32.add(x3, 4), mem), x4, mem), x7, x8, U32.from_nat(0n), x10, Atom.val(a, Wasm.Mem.load(U32.add(x3, 4), mem), x4, mem), x12, x13, x14, 0, 0, 0), {==}, {==}),
