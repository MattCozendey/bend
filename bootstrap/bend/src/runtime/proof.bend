# stop
def P.stop(+env: List<&2, Fun.V>, +ks: List<&2, Fun.Fr>, +n: Nat, +prog: List<&2, Fun.C>, +size: U32, +x0: U32, +x1: U32, +x2: U32, +x3: U32, +x4: U32, +x5: U32, +x6: U32, +x7: U32, +x8: U32, +x9: U32, +x10: U32, +x11: U32, +x12: U32, +x13: U32, +x14: U32, +x15: U32, +x16: U32, +x17: U32, +mem: Wasm.Mem, +hinv: {Inv.s(Fun.S.run{Fun.C.stop{}, env, ks}, x0, x1, x2, x3, x4, x5, x6, x7, mem, prog, size) == True{} : Bool}) ->
