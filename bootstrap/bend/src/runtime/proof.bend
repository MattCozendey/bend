        {==}, Cond.eqz(x7, True{}, hmode),
        R.seq(Imp.Stm.set{9n, RT.E.ld(0, RT.E.l(3n))}, RT.S.all([RT.I.disp()]), n, size, L(x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15, x16, x17), mem, L(x0, x1, x2, x3, x4, x5, x6, x7, x8, U32.from_nat(8n), x10, x11, x12, x13, x14, x15, x16, x17), mem, {Some{Imp.Res.trap{}} : Maybe<&2, Imp.Res>},
